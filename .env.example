# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_WS_URL=ws://localhost:3000

# Admin — server-only. Never prefix credentials with NEXT_PUBLIC_.
ADMIN_PASSWORD=replace-with-owner-supplied-secret
ADMIN_SESSION_SECRET=replace-with-a-long-random-session-secret

# Backend
NEXT_PUBLIC_BACKEND_API=http://localhost:8000

# Firebase public client configuration
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=balaa-studios-control-system
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# M-Pesa/Daraja server configuration
DARAJA_ENV=sandbox
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_SHORTCODE=
DARAJA_PASSKEY=
DARAJA_CALLBACK_URL=

